# Salin file ini menjadi .env.local lalu sesuaikan nilainya.
# Semua variabel di bawah punya nilai default untuk pengembangan lokal,
# tapi WAJIB diganti sebelum deploy ke produksi. Lihat README.md bagian
# "Environment Variables" untuk penjelasan masing-masing.

# Kunci rahasia untuk menandatangani cookie sesi login (HMAC-SHA256).
# Contoh membuat nilai acak: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# reCAPTCHA v2 ("saya bukan robot"). Nilai di bawah adalah TEST KEY resmi
# dari Google (selalu lolos verifikasi) — cocok untuk demo/development.
# Wajib diganti dengan key asli dari https://www.google.com/recaptcha/admin
# sebelum digunakan di produksi.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Model Gemini yang dipakai untuk transkripsi & ringkasan otomatis.
GEMINI_MODEL=gemini-2.0-flash

# CATATAN: API key AssemblyAI dan Gemini TIDAK diisi di sini.
# Keduanya diinput langsung dari halaman "API Key" di dalam aplikasi
# setelah login, dan disimpan di data store (lihat src/lib/db/store.ts).

# ---------------------------------------------------------------------------
# Sumber data aplikasi
# ---------------------------------------------------------------------------
# DB_CONNECT menentukan dari mana aplikasi membaca & menulis data:
#
#   "false" -> DATA DUMMY. Semua data diambil dari data/db.json (dibuat otomatis
#              dari src/lib/db/seed.ts saat pertama dijalankan). Tidak butuh
#              MySQL sama sekali — cocok untuk demo cepat.
#
#   "true"  -> DATABASE MySQL pada DATABASE_URL di bawah, lewat Prisma.
#              Sebelum dipakai, jalankan sekali: npm run db:setup
#              (membuat tabel + mengisi data dummy yang sama).
#
# DI VERCEL: bila DB_CONNECT="true" tapi DATABASE_URL menunjuk ke host lokal
# (localhost/127.0.0.1) — atau kosong — aplikasi OTOMATIS memakai data dummy,
# karena MySQL di laptop tidak mungkin dijangkau dari serverless. Jadi setelan
# di bawah aman dipakai apa adanya: lokal tetap MySQL, Vercel jalan dengan dummy.
# Isi DATABASE_URL di dashboard Vercel dengan database yang bisa diakses publik
# bila suatu saat ingin memakai Prisma di sana.
DB_CONNECT="false"

DATABASE_URL="mysql://root@localhost:3306/notulis_ai"
# Untuk PostgreSQL, ganti juga `provider` di prisma/schema.prisma menjadi "postgresql":
# DATABASE_URL="postgresql://user:password@localhost:5432/notulis_ai"

# Bila DB_CONNECT="true" tapi database tidak bisa dihubungi, secara default
# aplikasi otomatis mundur ke data dummy JSON supaya tetap bisa dipakai.
# Set DB_STRICT="true" untuk mematikan perilaku itu (error, bukan fallback) —
# disarankan di produksi agar kegagalan database tidak lewat tanpa disadari.
# DB_STRICT="false"
